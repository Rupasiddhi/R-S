{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rupasiddhi",
  "version": "1.0.0",
  "identifier": "app.vercel.rupasiddhi.desktop",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "රූපසිද්ධි | පද රූපසිද්ධි සංහිතා",
        "width": 1000,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Dhamma Study Apps",
    "category": "Education",
    "shortDescription": "රූපසිද්ධි — පාළි ව්‍යාකරණ සංහිතා",
    "longDescription": "Padarupasiddhi Pali grammar with the shadakara method (Sinhala). Works offline.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
